# fitcoach backend — copia in .env. Nessun valore qui è un segreto vero.

# dev | test | prod
APP_ENV=dev
APP_NAME=fitcoach
SUPPORT_EMAIL=supporto@fitcoach.example
FRONTEND_URL=http://localhost:3000
# allowlist esplicita, separata da virgole, senza slash finale (in produzione: https://<progetto>.vercel.app)
CORS_ORIGINS=http://localhost:3000
# Fuso in cui si decide "oggi": /today, sedute, costanza, job email, reset della quota chat (business-model §10).
# Alle 00:30 a Roma il backend in UTC direbbe ancora ieri: per questo ogni "oggi" passa da app/clock.py.
# (QUOTA_TIMEZONE, nome precedente, è ancora accettato.)
TIMEZONE=Europe/Rome

# Database. Vuoto in dev/test => Postgres embedded (pgserver, con pgvector) in EMBEDDED_PG_DIR.
# In produzione (Neon/Render) è obbligatoria: postgresql://user:pass@host/db?sslmode=require
# (asyncpg viene aggiunto da solo; sslmode -> ssl e channel_binding scartato in app/db.py). Su Neon: connessione DIRETTA, non pooled.
DATABASE_URL=
EMBEDDED_PG_DIR=.pgdata

# Auth
JWT_SECRET=cambia-questo-in-produzione-almeno-32-caratteri
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Rate limiting in-process (storage memory://): regge con 1 worker / 1 replica — vincolo di deploy v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute

# LLM: fake (default, nessuna chiave) | anthropic | openai
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_TONE=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_TONE=gpt-5.4
# Embedding: fake | openai (text-embedding-3-small, 1536 dim <= 2000: indicizzabile HNSW)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Quota chat (business-model §10): mese solare nel fuso TIMEZONE
CHAT_QUOTA_FREE_MONTH=15
CHAT_QUOTA_PRO_MONTH=300
CHAT_QUOTA_PRO_DAY=40

# Stripe (chiavi di test). Prezzi con tax_behavior=inclusive; Stripe Tax attivo sull'account.
# STRIPE_SECRET_KEY vuota => gateway disabilitato: /billing/checkout|portal|withdraw|webhook rispondono 503 billing_unavailable
# (mai un 500); /billing/founders resta vivo. Log di avvio: stripe_disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
STRIPE_PRICE_YEAR_FOUNDERS=
# Promotion Code (promo_...) a 100 utilizzi per il prezzo fondatori
STRIPE_FOUNDERS_PROMO_CODE_ID=
STRIPE_FOUNDERS_MAX=100
# Importi Pro in centesimi, IVA inclusa: devono coincidere con i Price su Stripe. Esposti da GET /billing/prices
# (e price_eur di /billing/founders); usati come fallback dell'importo del rimborso nel recesso.
PRO_PRICE_MONTH_CENTS=999
PRO_PRICE_YEAR_CENTS=5999
PRO_PRICE_YEAR_FOUNDERS_CENTS=4999
GRACE_DAYS=7
WITHDRAWAL_DAYS=14

# Email: fake (default) | resend
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=fitcoach <coach@fitcoach.example>

# Crossref polite pool: obbligatorio per `python -m scripts.seed`
CROSSREF_MAILTO=tu@example.org

# Job email di mancata seduta (task nel processo)
MISSED_SESSION_JOB_ENABLED=true
MISSED_SESSION_JOB_INTERVAL_S=3600
MISSED_SESSION_AFTER_HOURS=24

# Storico visibile in free (settimane)
FREE_HISTORY_WEEKS=8
